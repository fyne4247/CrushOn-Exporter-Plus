        )
      );

    return {
      fromApi,
      fields:f,
      filled,
      defHidden,

      ok:
        fromApi &&
        f.name &&
        filled.length > 0,

      why:
        !fromApi
          ? 'only page text was available (no API data)'
          : !f.name
            ? 'no character name'
            : !filled.length
              ? 'the character record came back empty'
              : ''
    };
  }


      'avatar_url',
      'image',
      'imageUrl',
      'image_url',
      'picture',
      'photo',
      'cover',
      'coverUrl',
      'thumbnail',
      'profileImage'
    ]
  };

  const pick = (obj, keys) => {
    for(const k of keys){
      const v = obj?.[k];

      if(typeof v === 'string' && v.trim()){
        return v.trim();
      }

      if(v && typeof v === 'object'){
        const inner = v.url || v.src || v.text || v.value;

        if(typeof inner === 'string' && inner.trim()){
          return inner.trim();
        }
      }
    }

    return '';
  };

  function characterIdFromPage(){
    const m = location.pathname.match(
      /\/character\/([^/?#]+)/i
    );

    if(m){
      return decodeURIComponent(m[1]);
    }

    const a = document.querySelector(
      'a[href*="/character/"]'
    );

    const m2 = a && a.getAttribute('href').match(
      /\/character\/([^/?#]+)/i
    );

    return m2
      ? decodeURIComponent(m2[1])
      : '';
  }

  // ---------- deep search ----------
  function scoreCandidate(o){
    if(!o || typeof o!=='object' || Array.isArray(o)){
      return 0;
    }

    if(!pick(o, CARD_KEYS.name)){
      return 0;
    }

    let s = 1;

    if(pick(o, CARD_KEYS.personality)) s += 4;
    if(pick(o, CARD_KEYS.first_mes))   s += 3;
    if(pick(o, CARD_KEYS.description)) s += 2;
    if(pick(o, CARD_KEYS.scenario))    s += 1;
    if(pick(o, CARD_KEYS.avatar))      s += 1;

    return s;
  }

  function deepBest(
    root,
    best={score:0, obj:null},
    depth=0,
    seen=new Set()
  ){
    if(
      !root ||
      typeof root!=='object' ||
      depth>12 ||
      seen.has(root)
    ){
      return best;
    }

    seen.add(root);

    const s = scoreCandidate(root);

    if(s > best.score){
      best = {
        score:s,
        obj:root
      };
    }

    for(const k in root){
      let v;

      try{
        v = root[k];
      }catch(_){
        continue;
      }

      if(v && typeof v==='object'){
        best = deepBest(
          v,
          best,
          depth+1,
          seen
        );
      }
    }

    return best;
  }

  // Pull JSON objects out of Next.js flight/embedded payloads.
  function jsonEndFrom(str, start){
    let depth=0;
    let inStr=false;
    let esc=false;

    for(let i=start;i<str.length;i++){
      const c = str[i];

      if(inStr){
        if(esc) esc=false;
        else if(c==='\\') esc=true;
        else if(c==='"') inStr=false;
        continue;
      }

      if(c==='"'){
        inStr=true;
      }else if(c==='{'){
        depth++;
      }else if(c==='}'){
        depth--;

        if(!depth){
          return i+1;
        }
      }
    }

    return -1;
  }

  function objectsAroundMarkers(text){
    const out=[];

    const markers=/"(?:personality|persona|definition|greeting|firstMessage|first_mes|scenario|exampleDialogs)"\s*:/g;

    let m;
    let guard=0;

    while(
      (m = markers.exec(text)) &&
      guard++ < 60
    ){
      let starts=[];
      let i=m.index;

      while(i>=0 && starts.length<25){
        i = text.lastIndexOf('{', i-1);

        if(i<0) break;

        starts.push(i);
      }

      for(const st of starts){
        const end = jsonEndFrom(text, st);

        if(end > m.index){
          try{
            out.push(
              JSON.parse(
                text.slice(st, end)
              )
            );
          }catch(_){}

          break;
        }
      }
    }

    return out;
  }

  function embeddedPayloads(){
    const blobs=[];

    try{
      if(window.__NEXT_DATA__){
        blobs.push(window.__NEXT_DATA__);
      }
    }catch(_){}

    try{
      const f = self.__next_f;

      if(Array.isArray(f)){
        const text = f
          .map(x=>Array.isArray(x)? x[1] : '')
          .filter(x=>typeof x==='string')
          .join('');

        if(text){
          objectsAroundMarkers(
            text
              .replace(/\\"/g,'"')
              .replace(/\\n/g,'\n')
          ).forEach(
            o=>blobs.push(o)
          );
        }
      }
    }catch(_){}

    qsa(
      'script[type="application/json"], script[type="application/ld+json"]'
    ).forEach(s=>{
      try{
        blobs.push(
          JSON.parse(s.textContent)
        );
      }catch(_){}
    });

    return blobs;
  }

  // ---------- tRPC character lookup ----------
  function mergeChar(a, b){
    if(
      !b ||
      typeof b!=='object' ||
      Array.isArray(b)
    ){
      return a;
    }

    if(!a){
      return Object.assign({}, b);
    }

    for(const k in b){
      let v;

      try{
        v = b[k];
      }catch(_){
        continue;
      }

      const cur = a[k];

      if(
        v === null ||
        v === undefined ||
        v === ''
      ){
        continue;
      }

      if(typeof v === 'string'){
        if(
          typeof cur !== 'string' ||
          v.length > cur.length
        ){
          a[k] = v;
        }

        continue;
      }

      if(Array.isArray(v)){
        if(
          !Array.isArray(cur) ||
          v.length > cur.length
        ){
          a[k] = v;
        }

        continue;
      }

      if(typeof v === 'object'){
        a[k] = mergeChar(
          cur &&
          typeof cur==='object' &&
          !Array.isArray(cur)
            ? cur
            : null,
          v
        );

        continue;
      }

      if(
        cur === undefined ||
        cur === null ||
        cur === ''
      ){
        a[k] = v;
      }
    }

    return a;
  }

  function unwrapChar(j){
    if(!j || typeof j!=='object'){
      return null;
    }

    if(pick(j, CARD_KEYS.name)){
      return j;
    }

    for(const k of [
      'character',
      'oc',
      'data',
      'info',
      'characterInfo',
      'detail'
    ]){
      const v = j[k];

      if(
        v &&
        typeof v==='object' &&
        pick(v, CARD_KEYS.name)
      ){
        return v;
      }
    }

    const best = deepBest(j);

    return best.obj;
  }

  async function trpcCharacterLookup(id, onStep){
    if(!id){
      return null;
    }

    const step = onStep || (()=>{});

    let acc = null;
    let hits = [];

    const attempt = async (proc, input) => {
      try{
        const j = await trpc(proc, input);
        const c = unwrapChar(j);

        if(c){
          acc = mergeChar(acc, c);
          hits.push(proc);
          return true;
        }
      }catch(_){}

      return false;
    };

    step('getCharacterForNewChat');

    await attempt(
      'character.getCharacterForNewChat',
      {characterId:id}
    );

    step('getOriginalCharacterInfo');

    await attempt(
      'character.getOriginalCharacterInfo',
      {characterId:id}
    );

    if(
      !pick(acc||{}, CARD_KEYS.personality) ||
      !pick(acc||{}, CARD_KEYS.first_mes)
    ){
      step('getCharacter');

      for(const dp of [
        2,5,6,8,9,
        0,1,3,4,7,
        10,11,12
      ]){
        if(
          await attempt(
            'character.getCharacter',
            {
              characterId:id,
              displayPosition:dp
            }
          )
        ){
          break;
        }
      }
    }

    if(!acc){
      step('getCharacter4Memory');

      await attempt(
        'character.getCharacter4Memory',
        {characterId:id}
      );
    }

    step('queryRecentCharacters');

    try{
      const j = await trpc(
        'character.queryRecentCharacters',
        {
          nsfw:true,
          locale:'en'
        }
      );

      const list =
        j?.characters ||
        j?.items ||
        (
          Array.isArray(j)
            ? j
            : []
        );

      const row = Array.isArray(list)
        ? list.find(
            x =>
              x &&
              String(x.id)===String(id)
          )
        : null;

      if(row){
        acc = mergeChar(acc, row);
        hits.push('queryRecentCharacters');
      }
    }catch(_){}

    if(acc){
      acc.__procs = hits;
    }

    return acc;
  }


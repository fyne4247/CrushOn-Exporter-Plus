  function b64utf8(str){
    const bytes = new TextEncoder().encode(str);
    let s=''; const CH=0x8000;
    for(let i=0;i<bytes.length;i+=CH) s += String.fromCharCode.apply(null, bytes.subarray(i, i+CH));
    return btoa(s);
  }
  function embedCharaChunk(png, jsonStr){
    if(!PNG_SIG.every((b,i)=>png[i]===b)) throw new Error('not a PNG');
    const keep=[]; let end=null; let p=8;
    const dv = new DataView(png.buffer, png.byteOffset, png.byteLength);
    while(p + 8 <= png.length){
      const len = dv.getUint32(p);
      const type = String.fromCharCode(png[p+4],png[p+5],png[p+6],png[p+7]);
      const chunk = png.subarray(p, p + 12 + len);
      if(type === 'IEND'){ end = chunk; break; }
      const isOldCard = type==='tEXt' && /^(chara|ccv3)\0/.test(String.fromCharCode(...chunk.subarray(8, Math.min(8+8, chunk.length))));
      if(!isOldCard) keep.push(chunk);
      p += 12 + len;
    }
    const b64 = b64utf8(jsonStr);
    const parts = [ new Uint8Array(PNG_SIG), ...keep, textChunk('chara', b64), end || makeChunk('IEND', new Uint8Array(0)) ];
    const total = parts.reduce((n,a)=>n+a.length, 0);
    const out = new Uint8Array(total); let o=0;
    for(const a of parts){ out.set(a, o); o += a.length; }
    return out;
  }

  // --- image fetching / conversion --------------------------------------------
  function gmFetchBlob(url){
    return new Promise((resolve,reject)=>{
      if(typeof GM_xmlhttpRequest !== 'function') return reject(new Error('no GM_xmlhttpRequest'));
      GM_xmlhttpRequest({ method:'GET', url, responseType:'blob',
        onload: r => (r.status>=200 && r.status<300 && r.response) ? resolve(r.response) : reject(new Error('http '+r.status)),
        onerror: () => reject(new Error('gm error')), ontimeout: () => reject(new Error('timeout')) });
    });
  }
  async function getImageBlob(url){
    if(!url) throw new Error('no avatar url');
    const abs = new URL(url, location.href).href;
    try{
      const r = await fetch(abs, {mode:'cors', credentials:'omit'});
      if(r.ok) return await r.blob();
    }catch(_){ }
    return await gmFetchBlob(abs);
  }
  async function blobToPngBytes(blob){
    const head = new Uint8Array(await blob.slice(0,8).arrayBuffer());
    if(PNG_SIG.every((b,i)=>head[i]===b)) return new Uint8Array(await blob.arrayBuffer());
    let src;
    try{ src = await createImageBitmap(blob); }
    catch(_){
      src = await new Promise((res,rej)=>{ const u=URL.createObjectURL(blob); const im=new Image();
        im.onload=()=>{ URL.revokeObjectURL(u); res(im); }; im.onerror=()=>{ URL.revokeObjectURL(u); rej(new Error('decode failed')); }; im.src=u; });
    }
    const cv = document.createElement('canvas');
    cv.width = src.width || 400; cv.height = src.height || 600;
    cv.getContext('2d').drawImage(src, 0, 0);
    const out = await new Promise(res => cv.toBlob(res, 'image/png'));
    return new Uint8Array(await out.arrayBuffer());
  }
  async function placeholderPngBytes(name){
    const cv = document.createElement('canvas'); cv.width=400; cv.height=600;
    const g = cv.getContext('2d');
    g.fillStyle='#15151a'; g.fillRect(0,0,400,600);
    g.fillStyle='#e6e6e6'; g.font='bold 120px system-ui,sans-serif'; g.textAlign='center'; g.textBaseline='middle';
    g.fillText((name||'?').trim().slice(0,2).toUpperCase(), 200, 280);
    g.fillStyle='#9a9aa8'; g.font='22px system-ui,sans-serif';
    g.fillText(String(name||'').slice(0,24), 200, 400);
    const blob = await new Promise(res => cv.toBlob(res,'image/png'));
    return new Uint8Array(await blob.arrayBuffer());
  }

  // --- card assembly ----------------------------------------------------------
  function normalizeExamples(v){
    if(Array.isArray(v)) return v.map(x => typeof x==='string' ? x : (x?.text || x?.content || '')).filter(Boolean).join('\n');
    return typeof v==='string' ? v : '';
  }
  // creator is sometimes a string, sometimes {id,name}; user{id,name} is the other spelling
  function creatorName(c){
    const cand = [c?.creator, c?.user, c?.author];
    for(const v of cand){
      if(typeof v === 'string' && v.trim()) return v.trim();
      if(v && typeof v === 'object'){
        const n = v.name || v.userName || v.username || v.nickName;
        if(typeof n === 'string' && n.trim()) return n.trim();
      }
    }
    return pick(c, CARD_KEYS.creator);
  }
  // avatars: prefer the full-size one, fall back through the thumbnail forms
  function avatarUrlOf(c){
    const ca = c?.characterAvatar;
    const cands = [
      ca?.avatar, ca?.originalAvatar, ca?.thumbnailAvatar,
      c?.avatar, c?.avatarUrl, c?.image, c?.imageUrl, c?.cover
    ];
    for(const v of cands){ if(typeof v==='string' && v.trim()) return v.trim(); }
    return pick(c, CARD_KEYS.avatar);
  }
  function buildV2Card(c, meta){
    const data = {
      name:        cleanAiNameExact(pick(c, CARD_KEYS.name)),
      description: stripHTML(pick(c, CARD_KEYS.description)),
      personality: stripHTML(pick(c, CARD_KEYS.personality)),
      scenario:    stripHTML(pick(c, CARD_KEYS.scenario)),
      first_mes:   stripHTML(pick(c, CARD_KEYS.first_mes)),
      mes_example: stripHTML(normalizeExamples(c.exampleDialogs ?? c.exampleDialogue ?? c.exampleConversation ?? c.mes_example ?? c.examples)),
      creator_notes: `Exported from ${location.href} on ${new Date().toISOString()}`,
      system_prompt: '',
      post_history_instructions: '',
      alternate_greetings: Array.isArray(c.alternateGreetings) ? c.alternateGreetings.map(String)
                          : Array.isArray(c.greetings) ? c.greetings.slice(1).map(String) : [],
      tags: Array.isArray(c.tags) ? c.tags.map(t => typeof t==='string' ? t : (t?.slug || t?.name || t?.title || '')).filter(Boolean) : [],
      creator: creatorName(c),
      character_version: String(c.version ?? '1.0'),
      extensions: { crushon: { id: meta.id || '', url: location.href, source: meta.source } }
    };
    if(!data.personality && data.description){ data.personality = data.description; }
    const card = { spec:'chara_card_v2', spec_version:'2.0', data };
    // legacy top-level mirror so older frontends still read it
    return Object.assign({
      name: data.name, description: data.description, personality: data.personality,
      scenario: data.scenario, first_mes: data.first_mes, mes_example: data.mes_example
    }, card);
  }

  async function findCharacter(onStep){
    const id = characterIdFromPage();

    // tRPC first: on CrushOn nothing is inlined into the page, so the API is
    // the only place the real definition lives.
    if(id){
      const api = await trpcCharacterLookup(id, onStep);
      if(api) return { c: api, id, source:'trpc:' + (api.__procs||[]).join('+') };
    }

    // page data / DOM only as a safety net (older or different page shapes)
    let best = {score:0, obj:null};
    for(const b of embeddedPayloads()){ best = deepBest(b, best); }
    if(best.obj) return { c: best.obj, id, source:'page-data' };
    const dom = domFallback();
    if(dom) return { c: dom, id, source:'dom' };
    return null;
  }

  async function exportCharacterPNG(){
    closeMenus();
    setStatus('reading character…','muted');
    showPrompt('Looking up the character…', {ok:false, cancel:false});
    try{
      const found = await findCharacter(s => updatePrompt('Looking up the character… ('+s+')', {ok:false, cancel:false}));
      if(!found){
        updatePrompt('Could not find character data on this page. Open the character’s profile or a chat with them, then try again.', {cancel:false, okText:'ok', onOK:hidePrompt});
        setStatus('character not found','warn'); return;
      }
      const {c, id, source} = found;
      const gate = await accessCheck(c);
      if(!gate.allowed){
        updatePrompt(`Export blocked: ${gate.why}.`, {cancel:false, okText:'ok', onOK:hidePrompt});
        setStatus('export blocked','warn'); return;
      }

      const card = buildV2Card(c, {id, source});
      if(!card.name || card.name==='AI') card.name = card.data.name = currentAIName();

      updatePrompt(`Building card for “${card.name}” (${gate.why})…`, {ok:false, cancel:false});
      let png;
      const avatarUrl = avatarUrlOf(c) || document.querySelector('meta[property="og:image"]')?.content || '';
      try{
        png = await blobToPngBytes(await getImageBlob(avatarUrl));
      }catch(err){
        png = await placeholderPngBytes(card.name);
      }
      const out = embedCharaChunk(png, JSON.stringify(card));
      const safe = card.name.replace(/[^\w\-]+/g,'_').slice(0,48) || 'character';
      download(`${safe}.png`, out, 'image/png');

      const thin = !card.data.personality && !card.data.first_mes;
      updatePrompt(
        `Saved ${safe}.png (SillyTavern v2 card, source: ${source}${thin ? ' — only public blurb text was available, so the card is thin' : ''}).`,
        {cancel:false, okText:'ok', onOK:hidePrompt});
      setStatus('exported character .png','ok');
    }catch(err){
      updatePrompt('Character export failed: ' + (err && err.message || err), {cancel:false, okText:'ok', onOK:hidePrompt});
      setStatus('character export failed','warn');
    }
  }


  // ---------- CrushOn tRPC + RSC access ----------
  function trpcInput(v){
    return (v === undefined || v === null)
      ? { json: null, meta: { values: ['undefined'] } }
      : { json: v };
  }
  async function trpc(proc, input){
    const url = `${location.origin}/api/trpc/${proc}?batch=1&input=` +
                encodeURIComponent(JSON.stringify({ 0: trpcInput(input) }));
    const r = await fetch(url, { credentials:'include', headers:{ 'trpc-accept':'application/json', 'content-type':'application/json' } });
    let j = null; try{ j = await r.json(); }catch(_){ }
    const slot = Array.isArray(j) ? j[0] : j;
    if(slot && slot.error) throw new Error(slot.error?.json?.message || slot.error?.message || 'trpc error');
    return slot?.result?.data?.json ?? slot?.result?.data ?? null;
  }
  async function rscFetch(path){
    const r = await fetch(location.origin + path, {
      credentials:'include',
      headers:{ 'RSC':'1', 'Next-Router-Prefetch':'1', 'accept':'*/*' }
    });
    if(!r.ok) throw new Error('http ' + r.status);
    return await r.text();
  }

  // ---------- character data probe (diagnostic) ----------
  async function trpcRaw(proc, input){
    const url = `${location.origin}/api/trpc/${proc}?batch=1&input=` +
                encodeURIComponent(JSON.stringify({ 0: trpcInput(input) }));
    const r = await fetch(url, { credentials:'include', headers:{ 'trpc-accept':'application/json', 'content-type':'application/json' } });
    const t = await r.text();
    return { status: r.status, body: t };
  }

  async function probeCharacterData(){
    closeMenus();
    setStatus('probing…','muted');
    showPrompt('Probing…', {ok:false, cancel:false});
    const id = characterIdFromPage();
    const out = [];
    out.push('URL: ' + location.href);
    out.push('character id: ' + (id || '(none found)'));
    try{ out.push('your user id: ' + (await currentUserId() || '(unknown)')); }catch(e){ out.push('your user id: error ' + e.message); }
    out.push('');

    const PROCS = [
      ['character.getCharacterForNewChat',   {characterId:id}],
      ['character.getOriginalCharacterInfo', {characterId:id}],
      ['character.getCharacter4Memory',      {characterId:id}],
      ['character.queryOwnCharacter',        {characterId:id}]
    ];
    for(let dp=0; dp<=12; dp++) PROCS.push(['character.getCharacter', {characterId:id, displayPosition:dp}]);

    for(const [proc, input] of PROCS){
      updatePrompt('Probing ' + proc + '…', {ok:false, cancel:false});
      try{
        const {status, body} = await trpcRaw(proc, input);
        const tag = proc + ' ' + JSON.stringify(input);
        out.push('--- ' + tag + ' -> HTTP ' + status + ' ---');
        out.push(String(body).slice(0, 20000));
        out.push('');
      }catch(e){
        out.push('--- ' + proc + ' -> threw: ' + e.message + ' ---');
        out.push('');
      }
    }

    updatePrompt('Merging…', {ok:false, cancel:false});
    out.push('########## merged character object ##########');
    try{
      const found = await findCharacter();
      if(!found){ out.push('(findCharacter returned nothing)'); }
      else{
        out.push('source: ' + found.source);
        const gate = await accessCheck(found.c);
        out.push('access: ' + (gate.allowed ? 'ALLOWED' : 'BLOCKED') + ' — ' + gate.why);
        out.push('avatar url: ' + (avatarUrlOf(found.c) || '(none)'));
        out.push('');
        out.push(JSON.stringify(found.c, null, 2).slice(0, 60000));
        out.push('');
        out.push('########## card that would be written ##########');
        out.push(JSON.stringify(buildV2Card(found.c, {id, source:found.source}), null, 2).slice(0, 40000));
      }
    }catch(e){ out.push('merge failed: ' + e.message); }

    const text = out.join('\n');
    const stamp = new Date().toISOString().replace(/[:.]/g,'-');
    download('crushon-probe4-' + stamp + '.txt', text, 'text/plain');
    try{ await navigator.clipboard.writeText(text); }catch(_){ }
    updatePrompt('Probe saved as crushon-probe4-' + stamp + '.txt', {cancel:false, okText:'ok', onOK:hidePrompt});
    setStatus('probe done','ok');
  }


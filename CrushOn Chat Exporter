  function normalizeExamples(v){
    if(Array.isArray(v)){
      return v
        .map(
          x =>
            typeof x==='string'
              ? x
              : (
                  x?.text ||
                  x?.content ||
                  ''
                )
        )
        .filter(Boolean)
        .join('\n');
    }

    return typeof v==='string'
      ? v
      : '';
  }

  function exampleTextOf(c){
    const s = stripHTML(
      normalizeExamples(
        c?.example_conversation
        ??
        c?.exampleDialogs
        ??
        c?.exampleDialogue
        ??
        c?.exampleConversation
        ??
        c?.mes_example
        ??
        c?.examples
      )
    );

    if(s && s.trim()){
      return s;
    }

    const msgs =
      c?.newExampleConversation
        ?.messages;

    if(
      Array.isArray(msgs) &&
      msgs.length
    ){
      const out = msgs
        .map(m => {
          const txt = stripHTML(
            (
              m?.content
              ??
              m?.text
              ??
              m?.message
              ??
              ''
            ).toString()
          );

          if(!txt){
            return '';
          }

          const who = String(
            m?.role
            ??
            m?.who
            ??
            ''
          ).toLowerCase();

          const tag =
            /user|human/.test(who)
              ? '{{user}}'
              : '{{char}}';

          return tag + ': ' + txt;
        })
        .filter(Boolean);

      if(out.length){
        return '<START>\n' +
          out.join('\n');
      }
    }

    return '';
  }

  function cardQuality(c, source){
    const fromApi =
      /^trpc/.test(

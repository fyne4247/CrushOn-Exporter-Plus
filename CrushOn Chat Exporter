        !!String(
          pick(
            c,
            CARD_KEYS.first_mes
          ) || ''
        ).trim(),

      mes_example:
        !!exampleTextOf(c)
    };

    const filled = [
      'description',
      'personality',
      'scenario',
      'first_mes',
      'mes_example'
    ].filter(k=>f[k]);

    const defMissing =
      !f.personality &&
      !f.scenario &&
      !f.mes_example;

    const defHidden =
      defMissing &&
      (
        c?.definitionVisibility === 2 ||
        (
          fromApi &&

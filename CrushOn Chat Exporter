  // ---------- download/export ----------
  // Lite mode bypasses mobile sharing so its three files do not collide in one share sheet.
  let LITE_BATCH=false;

  const download=(name,data,mime)=>{
    const type = mime || 'text/plain;charset=utf-8';
    const blob = new Blob([data], {type: type});

    const tryShare = async ()=>{
      if(LITE_BATCH) return false;

      try{
        if(navigator.canShare && typeof File!=='undefined'){
          const f=new File([blob], name, {type});

          if(navigator.canShare({files:[f]})){
            await navigator.share({files:[f], title:name});
            return true;
          }
        }
      }catch(_){ }

      return false;
    };

    const tryAnchor = ()=>{
      try{
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');

        a.href=url;
        a.download=name;
        a.rel='noopener';
        a.target='_self';

        document.body.appendChild(a);
        a.click();

        setTimeout(()=>{
          URL.revokeObjectURL(url);
          a.remove();
        }, 1500);

        return true;
      }catch(_){
        return false;
      }
    };

    const tryGM = ()=>{
      if(typeof GM_download==='function'){
        try{
          const url = (typeof data==='string')
            ? ('data:'+type+','+encodeURIComponent(data))
            : URL.createObjectURL(blob);

          GM_download({
            url,
            name,
            saveAs:true
          });

          return true;
        }catch(_){
          return false;
        }
      }

      return false;
    };

    const tryMs = ()=>{
      try{
        if('msSaveOrOpenBlob' in navigator){
          navigator.msSaveOrOpenBlob(blob, name);
          return true;
        }
      }catch(_){}

      return false;
    };

    (async()=>{
      if(await tryShare()) return;
      if(tryAnchor()) return;
      if(tryGM()) return;
      if(tryMs()) return;

      const url=URL.createObjectURL(blob);
      window.open(url,'_blank');

      setTimeout(
        ()=>URL.revokeObjectURL(url),
        2000
      );
    })();
  };


  // --- access gate ------------------------------------------------------------
  // NextAuth session endpoint is the clean source for your own user id.
  let _meId = null;
  async function currentUserId(){
    if(_meId !== null) return _meId;
    _meId = '';
    try{
      const r = await fetch(location.origin + '/api/auth/session', {credentials:'include', headers:{accept:'application/json'}});
      if(r.ok){
        const j = await r.json();
        const u = j?.user || j;
        const v = u?.id || u?.userId || u?.sub || j?.userId || '';
        if(v) _meId = String(v);
      }
    }catch(_){ }
    if(!_meId){
      // fallback: dig through whatever the page already loaded
      const hunt = (o, d=0, seen=new Set()) => {
        if(!o || typeof o!=='object' || d>8 || seen.has(o)) return '';
        seen.add(o);
        if((o.id || o.userId || o._id) && (o.email || o.userName || o.username || o.nickName)) return String(o.id || o.userId || o._id);
        for(const k in o){ let v; try{ v=o[k]; }catch(_){ continue; } if(v && typeof v==='object'){ const r=hunt(v,d+1,seen); if(r) return r; } }
        return '';
      };
      for(const b of embeddedPayloads()){ const r = hunt(b); if(r){ _meId = r; break; } }
    }

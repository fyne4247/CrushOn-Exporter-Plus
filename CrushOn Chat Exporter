  }

  // CrushOn's own rule, lifted from their bundle:
  //   getCharacterCreatorId = c => c?.user?.id ?? c?.creator?.id
  function characterCreatorId(c){
    const v = (c && c.user && c.user.id) ?? (c && c.creator && c.creator.id)
           ?? c?.creatorId ?? c?.userId ?? c?.authorId ?? c?.ownerId;
    return v ? String(v) : '';
  }

  // Returns {allowed:boolean, why:string}
  async function accessCheck(c){
    const owner = characterCreatorId(c);
    const me = await currentUserId();
    if(owner && me && owner === me) return {allowed:true, why:'you own this character'};

    // visibility is a numeric enum on CrushOn. Public characters observed as 3.
    // Treat only values we can positively read as private as a block, so an
    // unknown enum value never silently eats a legitimate export.
    const vis = c?.visibility;
    const visStr = String(vis ?? c?.status ?? c?.privacy ?? '').toLowerCase();
    const isPrivate =
      c?.isPublic === false || c?.public === false ||
      c?.isPrivate === true || c?.private === true ||
      /^(private|draft|unlisted|hidden)$/.test(visStr) ||
      vis === 1 || vis === 2;   // 3 = public; 1/2 are the non-public tiers

    if(isPrivate) return {allowed:false, why:'this character is private and not yours — export blocked'};
    return {allowed:true, why:'public profile'};

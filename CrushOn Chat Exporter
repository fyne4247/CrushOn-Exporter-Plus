  // ---------- capture ----------
  async function captureNow(){
    clearCaptured(true);
    clearCalibration('captureNow');

    showPrompt('Attempting auto-calibration…',{cancel:false, ok:false});
    await sleep(100);

    const auto=autoCalibrateTry();


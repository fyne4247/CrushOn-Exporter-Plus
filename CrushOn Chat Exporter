            ? c.greetings
                .slice(1)
                .map(String)
            : [],

      tags:
        Array.isArray(c.tags)
          ? c.tags
              .map(
                t =>
                  typeof t==='string'
                    ? t
                    : (
                        t?.slug ||
                        t?.name ||
                        t?.title ||
                        ''
                      )
              )
              .filter(Boolean)
          : [],

      creator:
        creatorName(c),

      character_version:
        String(
          c.version ??
          '1.0'
        ),

      extensions:{
        crushon:{
          id:meta.id || '',
          url:location.href,
          source:meta.source
        }
      }
    };

    const extra = [];

    const appearance =
      String(
        c?.appearance || ''
      ).trim();

    if(appearance){
      extra.push(
        'Appearance: ' +
        stripHTML(appearance)
      );
    }

    if(c?.age){
      extra.push(
        'Age: ' + c.age
      );
    }

    if(extra.length){
      data.description =
        (
          data.description
            ? data.description + '\n\n'
            : ''
        )
        +
        extra.join('\n');
    }

    const q = cardQuality(
      c,
      meta.source
    );

    if(q.defHidden){
      data.creator_notes +=
        '\nNOTE: the creator hid this character’s definition on CrushOn, ' +
        'so personality / scenario / example dialogue were not available.';
    }

    const card = {
      spec:'chara_card_v2',
      spec_version:'2.0',
      data
    };

    return Object.assign(
      {
        name:data.name,
        description:data.description,
        personality:data.personality,
        scenario:data.scenario,
        first_mes:data.first_mes,
        mes_example:data.mes_example
      },
      card
    );
  }

  async function findCharacter(onStep){
    const id = characterIdFromPage();

    if(id){
      const api =
        await trpcCharacterLookup(
          id,
          onStep
        );

      if(api){
        return {
          c:api,
          id,
          source:
            'trpc:' +
            (
              api.__procs ||
              []
            ).join('+')
        };
      }
    }

    let best = {
      score:0,
      obj:null
    };

    for(const b of embeddedPayloads()){
      best = deepBest(
        b,
        best
      );
    }

    if(best.obj){
      return {
        c:best.obj,
        id,
        source:'page-data'
      };
    }

    const dom = domFallback();

    if(dom){
      return {
        c:dom,
        id,
        source:'dom'
      };
    }

    return null;
  }

  async function exportCharacterPNG(){
    closeMenus();

    setStatus(
      'reading character…',
      'muted'
    );

    showPrompt(
      'Looking up the character…',
      {
        ok:false,
        cancel:false
      }
    );

    try{
      if(!CHAR){
        await captureCharacter(
          s => updatePrompt(
            'Looking up the character… ('+s+')',
            {
              ok:false,
              cancel:false
            }
          )
        );
      }

      if(!CHAR){
        updatePrompt(
          'Could not find character data on this page. Open the character’s profile or a chat with them, then try again.',
          {
            cancel:false,
            okText:'ok',
            onOK:hidePrompt
          }
        );

        setStatus(
          'character not found',
          'warn'
        );

        return;
      }

      const {
        c,
        id,
        source,
        gate,
        q
      } = CHAR;

      if(!gate.allowed){
        updatePrompt(
          `Export blocked: ${gate.why}.`,
          {
            cancel:false,
            okText:'ok',
            onOK:hidePrompt
          }
        );

        setStatus(
          'export blocked',
          'warn'
        );

        return;
      }

      if(!q.ok){
        updatePrompt(
          `Can't build a character card: ${q.why}.\n\n` +
          'Open the character’s profile or a chat with them and press “Capture now” first.',
          {
            cancel:false,
            okText:'ok',
            onOK:hidePrompt
          }
        );

        setStatus(
          'no character data',
          'warn'
        );

        return;
      }

      const card = buildV2Card(
        c,
        {
          id,
          source
        }
      );

      if(
        !card.name ||
        card.name==='AI'
      ){
        card.name =
        card.data.name =
          currentAIName();
      }

      updatePrompt(
        `Building card for “${card.name}” (${gate.why})…`,
        {
          ok:false,
          cancel:false
        }
      );

      let png;

      const avatarUrl =
        avatarUrlOf(c) ||
        document.querySelector(
          'meta[property="og:image"]'
        )?.content ||
        '';

      try{
        png = await blobToPngBytes(
          await getImageBlob(
            avatarUrl
          )
        );
      }catch(err){
        png =
          await placeholderPngBytes(
            card.name
          );
      }

      const out = embedCharaChunk(
        png,
        JSON.stringify(card)
      );

      const safe =
        card.name
          .replace(
            /[^\w\-]+/g,
            '_'
          )
          .slice(0,48)
        ||
        'character';

      download(
        `${safe}.png`,
        out,
        'image/png'
      );

      updatePrompt(
        [
          `Saved ${safe}.png — SillyTavern v2 card.`,
          '',
          `Included: ${q.filled.join(', ')}.`,
          q.defHidden
            ? 'The creator hid this character’s definition on CrushOn, so personality, scenario and example dialogue were not available.'
            : '',
          `Source: ${source}.`
        ]
          .filter(Boolean)
          .join('\n'),

        {
          cancel:false,
          okText:'ok',
          onOK:hidePrompt
        }
      );

      setStatus(
        'exported character .png',
        'ok'
      );
    }catch(err){
      updatePrompt(
        'Character export failed: ' +
        (
          err &&
          err.message ||
          err
        ),
        {
          cancel:false,
          okText:'ok',
          onOK:hidePrompt
        }
      );

      setStatus(
        'character export failed',
        'warn'
      );
    }
  }

  // ---------- CrushOn tRPC + RSC access ----------
  function trpcInput(v){
    return (
      v === undefined ||
      v === null
    )
      ? {
          json:null,
          meta:{
            values:[
              'undefined'
            ]
          }
        }
      : {
          json:v
        };
  }

  async function trpc(proc, input){
    const url =
      `${location.origin}/api/trpc/${proc}?batch=1&input=` +
      encodeURIComponent(
        JSON.stringify({
          0:trpcInput(input)
        })
      );

    const r = await fetch(
      url,
      {
        credentials:'include',
        headers:{
          'trpc-accept':'application/json',
          'content-type':'application/json'
        }
      }
    );

    let j = null;

    try{
      j = await r.json();
    }catch(_){}

    const slot =
      Array.isArray(j)
        ? j[0]
        : j;

    if(
      slot &&
      slot.error
    ){
      throw new Error(
        slot.error?.json?.message ||
        slot.error?.message ||
        'trpc error'
      );
    }

    return (
      slot?.result?.data?.json
      ??
      slot?.result?.data
      ??
      null
    );
  }

  async function rscFetch(path){
    const r = await fetch(
      location.origin + path,
      {
        credentials:'include',
        headers:{
          'RSC':'1',
          'Next-Router-Prefetch':'1',
          'accept':'*/*'
        }
      }
    );

    if(!r.ok){
      throw new Error(
        'http ' + r.status
      );
    }

    return await r.text();
  }

  // ---------- character data probe ----------
  async function trpcRaw(proc, input){
    const url =
      `${location.origin}/api/trpc/${proc}?batch=1&input=` +
      encodeURIComponent(
        JSON.stringify({
          0:trpcInput(input)
        })
      );

    const r = await fetch(
      url,
      {
        credentials:'include',
        headers:{
          'trpc-accept':'application/json',
          'content-type':'application/json'
        }
      }
    );

    const t = await r.text();

    return {
      status:r.status,
      body:t
    };
  }

  async function probeCharacterData(){
    closeMenus();

    setStatus(
      'probing…',
      'muted'
    );

    showPrompt(
      'Probing…',
      {
        ok:false,
        cancel:false
      }
    );

    const id =
      characterIdFromPage();

    const out = [];

    out.push(
      'URL: ' + location.href
    );

    out.push(
      'character id: ' +
      (
        id ||
        '(none found)'
      )
    );

    try{
      out.push(
        'your user id: ' +
        (
          await currentUserId()
          ||
          '(unknown)'
        )
      );
    }catch(e){
      out.push(
        'your user id: error ' +
        e.message
      );
    }

    out.push('');

    const PROCS = [
      [
        'character.getCharacterForNewChat',
        {characterId:id}
      ],
      [
        'character.getOriginalCharacterInfo',
        {characterId:id}
      ],
      [
        'character.getCharacter4Memory',
        {characterId:id}
      ],
      [
        'character.queryOwnCharacter',
        {characterId:id}
      ]
    ];

    for(let dp=0; dp<=12; dp++){
      PROCS.push(
        [
          'character.getCharacter',
          {
            characterId:id,
            displayPosition:dp
          }
        ]
      );
    }

    for(const [proc, input] of PROCS){
      updatePrompt(
        'Probing ' + proc + '…',
        {
          ok:false,
          cancel:false
        }
      );

      try{
        const {
          status,
          body
        } = await trpcRaw(
          proc,
          input
        );

        const tag =
          proc +
          ' ' +
          JSON.stringify(input);

        out.push(
          '--- ' +
          tag +
          ' -> HTTP ' +
          status +
          ' ---'
        );

        out.push(
          String(body)
            .slice(0, 20000)
        );

        out.push('');
      }catch(e){
        out.push(
          '--- ' +
          proc +
          ' -> threw: ' +
          e.message +
          ' ---'
        );

        out.push('');
      }
    }

    updatePrompt(
      'Merging…',
      {
        ok:false,
        cancel:false
      }
    );

    out.push(
      '########## merged character object ##########'
    );

    try{
      const found =
        await findCharacter();

      if(!found){
        out.push(
          '(findCharacter returned nothing)'
        );
      }else{
        out.push(
          'source: ' +
          found.source
        );

        const gate =
          await accessCheck(
            found.c
          );

        out.push(
          'access: ' +
          (
            gate.allowed
              ? 'ALLOWED'
              : 'BLOCKED'
          )
          +
          ' — ' +
          gate.why
        );

        out.push(
          'avatar url: ' +
          (
            avatarUrlOf(found.c)
            ||
            '(none)'
          )
        );

        out.push('');

        out.push(
          JSON.stringify(
            found.c,
            null,
            2
          ).slice(
            0,
            60000
          )
        );

        out.push('');

        out.push(
          '########## card that would be written ##########'
        );

        out.push(
          JSON.stringify(
            buildV2Card(
              found.c,
              {
                id,
                source:found.source
              }
            ),
            null,
            2
          ).slice(
            0,
            40000
          )
        );
      }
    }catch(e){
      out.push(
        'merge failed: ' +
        e.message
      );
    }

    const text =
      out.join('\n');

    const stamp =
      new Date()
        .toISOString()
        .replace(
          /[:.]/g,
          '-'
        );

    download(
      'crushon-probe4-' +
      stamp +
      '.txt',
      text,
      'text/plain'
    );

    try{
      await navigator.clipboard
        .writeText(text);
    }catch(_){}

    updatePrompt(
      'Probe saved as crushon-probe4-' +
      stamp +
      '.txt',
      {
        cancel:false,
        okText:'ok',
        onOK:hidePrompt
      }
    );

    setStatus(
      'probe done',
      'ok'
    );
  }


  // ---------- SillyTavern character card export ----------
  // Builds a chara_card_v2 PNG (tEXt "chara" = base64 JSON) using the character's avatar.
  // Only exports when the character data is reachable: a public profile, or one you own.

  const CARD_KEYS = {
    // CrushOn's real field names come first, generic guesses after.
    name:        ['name','characterName','charName','title','displayName'],
    description: ['description','intro','bio','summary','about','shortDescription','profile'],
    personality: ['personality','appearance','persona','definition','characterDefinition','prompt','systemPrompt','instructions','longDescription'],
    scenario:    ['scenario','worldScenario','world','setting','context'],
    first_mes:   ['greeting','firstMessage','first_mes','firstMes','initialMessage','openingMessage','welcomeMessage'],
    mes_example: ['exampleDialogs','exampleDialogue','exampleConversation','example_dialogs','mes_example','examples','sampleDialog'],
    creator:     ['creator','author','userName','username','creatorName','ownerName','nickName'],
    avatar:      ['avatar','avatarUrl','avatar_url','image','imageUrl','image_url','picture','photo','cover','coverUrl','thumbnail','profileImage']
  };

  const pick = (obj, keys) => {
    for(const k of keys){
      const v = obj?.[k];
      if(typeof v === 'string' && v.trim()) return v.trim();
      if(v && typeof v === 'object'){
        const inner = v.url || v.src || v.text || v.value;
        if(typeof inner === 'string' && inner.trim()) return inner.trim();
      }
    }
    return '';
  };

  function characterIdFromPage(){
    const m = location.pathname.match(/\/character\/([^/?#]+)/i);
    if(m) return decodeURIComponent(m[1]);
    const a = document.querySelector('a[href*="/character/"]');
    const m2 = a && a.getAttribute('href').match(/\/character\/([^/?#]+)/i);
    return m2 ? decodeURIComponent(m2[1]) : '';
  }

  // --- deep search of anything the page already loaded -------------------------
  function scoreCandidate(o){
    if(!o || typeof o!=='object' || Array.isArray(o)) return 0;
    if(!pick(o, CARD_KEYS.name)) return 0;
    let s = 1;
    if(pick(o, CARD_KEYS.personality)) s += 4;
    if(pick(o, CARD_KEYS.first_mes))   s += 3;
    if(pick(o, CARD_KEYS.description)) s += 2;
    if(pick(o, CARD_KEYS.scenario))    s += 1;
    if(pick(o, CARD_KEYS.avatar))      s += 1;
    return s;
  }
  function deepBest(root, best={score:0, obj:null}, depth=0, seen=new Set()){
    if(!root || typeof root!=='object' || depth>12 || seen.has(root)) return best;
    seen.add(root);
    const s = scoreCandidate(root);
    if(s > best.score) best = {score:s, obj:root};
    for(const k in root){
      let v; try{ v = root[k]; }catch(_){ continue; }
      if(v && typeof v==='object') best = deepBest(v, best, depth+1, seen);
    }
    return best;
  }

  // Pull JSON objects out of Next.js flight/embedded payloads around a marker key.
  function jsonEndFrom(str, start){
    let depth=0, inStr=false, esc=false;
    for(let i=start;i<str.length;i++){
      const c = str[i];
      if(inStr){ if(esc) esc=false; else if(c==='\\') esc=true; else if(c==='"') inStr=false; continue; }
      if(c==='"') inStr=true;
      else if(c==='{') depth++;
      else if(c==='}'){ depth--; if(!depth) return i+1; }
    }
    return -1;
  }
  function objectsAroundMarkers(text){
    const out=[]; const markers=/"(?:personality|persona|definition|greeting|firstMessage|first_mes|scenario|exampleDialogs)"\s*:/g;
    let m, guard=0;
    while((m = markers.exec(text)) && guard++ < 60){
      let starts=[], i=m.index;
      while(i>=0 && starts.length<25){ i = text.lastIndexOf('{', i-1); if(i<0) break; starts.push(i); }
      for(const st of starts){
        const end = jsonEndFrom(text, st);
        if(end > m.index){
          try{ out.push(JSON.parse(text.slice(st, end))); }catch(_){ }
          break;
        }
      }
    }
    return out;
  }
  function embeddedPayloads(){
    const blobs=[];
    try{ if(window.__NEXT_DATA__) blobs.push(window.__NEXT_DATA__); }catch(_){}
    try{
      const f = self.__next_f;
      if(Array.isArray(f)){
        const text = f.map(x=>Array.isArray(x)? x[1] : '').filter(x=>typeof x==='string').join('');
        if(text) objectsAroundMarkers(text.replace(/\\"/g,'"').replace(/\\n/g,'\n')).forEach(o=>blobs.push(o));
      }
    }catch(_){}
    qsa('script[type="application/json"], script[type="application/ld+json"]').forEach(s=>{
      try{ blobs.push(JSON.parse(s.textContent)); }catch(_){}
    });
    return blobs;

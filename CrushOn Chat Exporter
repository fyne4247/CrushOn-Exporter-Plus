  async function accessCheck(c){
    const owner = characterCreatorId(c);
    const me = await currentUserId();

    if(
      owner &&
      me &&
      owner === me
    ){
      return {
        allowed:true,
        why:'you own this character'
      };
    }

    const vis = c?.visibility;

    const visStr = String(
      vis ??
      c?.status ??
      c?.privacy ??
      ''
    ).toLowerCase();

    const isPrivate =
      c?.isPublic === false ||
      c?.public === false ||
      c?.isPrivate === true ||
      c?.private === true ||
      /^(private|draft|unlisted|hidden)$/.test(visStr) ||
      vis === 1 ||
      vis === 2;

    if(isPrivate){
      return {
        allowed:false,
        why:'this character is private and not yours — export blocked'
      };
    }

    return {
      allowed:true,
      why:'public profile'
    };
  }

  // ---------- PNG writing ----------
  const PNG_SIG = [
    137,80,78,71,
    13,10,26,10
  ];

  const CRC_TABLE = (()=>{
    const t=new Uint32Array(256);

    for(let n=0;n<256;n++){
      let c=n;

      for(let k=0;k<8;k++){
        c = (c&1)
          ? (0xEDB88320 ^ (c>>>1))
          : (c>>>1);
      }

      t[n]=c>>>0;
    }

    return t;
  })();

  function crc32(bytes){
    let c=0xFFFFFFFF;

    for(let i=0;i<bytes.length;i++){
      c = CRC_TABLE[
        (c ^ bytes[i]) & 255
      ] ^ (c>>>8);
    }

    return (
      c ^ 0xFFFFFFFF
    )>>>0;
  }

  function be32(n){
    return [
      (n>>>24)&255,
      (n>>>16)&255,
      (n>>>8)&255,
      n&255
    ];
  }

  function latin1(str){
    const a=new Uint8Array(str.length);

    for(let i=0;i<str.length;i++){
      a[i]=str.charCodeAt(i)&255;
    }

    return a;
  }

  function makeChunk(type, dataBytes){
    const body = new Uint8Array(
      4 + dataBytes.length
    );

    body.set(
      latin1(type),
      0
    );

    body.set(
      dataBytes,
      4
    );

    const out = new Uint8Array(
      4 + body.length + 4
    );

    out.set(
      be32(dataBytes.length),
      0
    );

    out.set(
      body,
      4
    );

    out.set(
      be32(crc32(body)),
      4 + body.length
    );

    return out;
  }

  function textChunk(keyword, text){
    const k = latin1(keyword);
    const t = latin1(text);

    const d = new Uint8Array(
      k.length + 1 + t.length
    );

    d.set(k,0);
    d[k.length]=0;
    d.set(t, k.length+1);

    return makeChunk(
      'tEXt',
      d
    );
  }

  function b64utf8(str){
    const bytes = new TextEncoder()
      .encode(str);

    let s='';
    const CH=0x8000;

    for(
      let i=0;
      i<bytes.length;
      i+=CH
    ){
      s += String.fromCharCode.apply(
        null,
        bytes.subarray(
          i,
          i+CH
        )
      );
    }

    return btoa(s);
  }

  function embedCharaChunk(png, jsonStr){
    if(
      !PNG_SIG.every(
        (b,i)=>png[i]===b
      )
    ){
      throw new Error(
        'not a PNG'
      );
    }

    const keep=[];
    let end=null;
    let p=8;

    const dv = new DataView(
      png.buffer,
      png.byteOffset,
      png.byteLength
    );

    while(p + 8 <= png.length){
      const len = dv.getUint32(p);

      const type =
        String.fromCharCode(
          png[p+4],
          png[p+5],
          png[p+6],
          png[p+7]
        );

      const chunk = png.subarray(
        p,
        p + 12 + len
      );

      if(type === 'IEND'){
        end = chunk;
        break;
      }

      const isOldCard =
        type==='tEXt' &&
        /^(chara|ccv3)\0/.test(
          String.fromCharCode(
            ...chunk.subarray(
              8,
              Math.min(
                8+8,
                chunk.length
              )
            )
          )
        );

      if(!isOldCard){
        keep.push(chunk);
      }

      p += 12 + len;
    }

    const b64 = b64utf8(jsonStr);

    const parts = [
      new Uint8Array(PNG_SIG),
      ...keep,
      textChunk('chara', b64),
      end ||
      makeChunk(
        'IEND',
        new Uint8Array(0)
      )
    ];

    const total = parts.reduce(
      (n,a)=>n+a.length,
      0
    );

    const out = new Uint8Array(total);

    let o=0;

    for(const a of parts){
      out.set(a, o);
      o += a.length;
    }

    return out;
  }

  // ---------- image fetching / conversion ----------
  function gmFetchBlob(url){
    return new Promise((resolve,reject)=>{
      if(
        typeof GM_xmlhttpRequest !== 'function'
      ){
        return reject(
          new Error(
            'no GM_xmlhttpRequest'
          )
        );
      }

      GM_xmlhttpRequest({
        method:'GET',
        url,
        responseType:'blob',

        onload:r=>{
          if(
            r.status>=200 &&
            r.status<300 &&
            r.response
          ){
            resolve(r.response);
          }else{
            reject(
              new Error(
                'http '+r.status
              )
            );
          }
        },

        onerror:()=>{
          reject(
            new Error('gm error')
          );
        },

        ontimeout:()=>{
          reject(
            new Error('timeout')
          );
        }
      });
    });
  }


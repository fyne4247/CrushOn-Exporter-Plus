  // --- tRPC lookup (same-origin, uses your session cookies) -------------------
  // CrushOn's frontend is Next.js + tRPC. Procedure names and input shapes below
  // were read out of their own bundle, e.g.:
  //   character.getCharacter.useQuery({characterId, displayPosition})
  //   character.getCharacterForNewChat.useQuery({characterId})
  // Several procedures each return a partial view of the character, so we ask a
  // few and merge: whichever one actually has the description/greeting wins.

  // merge b into a, preferring the longer/non-empty value for each key
  function mergeChar(a, b){
    if(!b || typeof b!=='object' || Array.isArray(b)) return a;
    if(!a) return Object.assign({}, b);
    for(const k in b){
      let v; try{ v = b[k]; }catch(_){ continue; }
      const cur = a[k];
      if(v === null || v === undefined || v === '') continue;
      if(typeof v === 'string'){ if(typeof cur !== 'string' || v.length > cur.length) a[k] = v; continue; }
      if(Array.isArray(v)){ if(!Array.isArray(cur) || v.length > cur.length) a[k] = v; continue; }
      if(typeof v === 'object'){ a[k] = mergeChar(cur && typeof cur==='object' && !Array.isArray(cur) ? cur : null, v); continue; }
      if(cur === undefined || cur === null || cur === '') a[k] = v;
    }
    return a;
  }

  // pull the character-shaped object out of a procedure result (some wrap it)
  function unwrapChar(j){
    if(!j || typeof j!=='object') return null;
    if(pick(j, CARD_KEYS.name)) return j;
    for(const k of ['character','oc','data','info','characterInfo','detail']){
      const v = j[k];
      if(v && typeof v==='object' && pick(v, CARD_KEYS.name)) return v;
    }
    const best = deepBest(j);
    return best.obj;
  }

  async function trpcCharacterLookup(id, onStep){
    if(!id) return null;
    const step = onStep || (()=>{});
    let acc = null, hits = [];

    const attempt = async (proc, input) => {
      try{
        const j = await trpc(proc, input);
        const c = unwrapChar(j);
        if(c){ acc = mergeChar(acc, c); hits.push(proc); return true; }
      }catch(_){ }
      return false;
    };

    // 1) confirmed simple shape, returns the full definition used to start a chat
    step('getCharacterForNewChat');
    await attempt('character.getCharacterForNewChat', {characterId:id});

    // 2) the editor's own copy — richest source when the character is yours
    step('getOriginalCharacterInfo');
    await attempt('character.getOriginalCharacterInfo', {characterId:id});

    // 3) getCharacter needs {characterId, displayPosition}; displayPosition is a
    //    numeric enum whose value we don't know, so sweep it until one sticks.
    if(!pick(acc||{}, CARD_KEYS.personality) || !pick(acc||{}, CARD_KEYS.first_mes)){
      step('getCharacter');
      for(let dp=0; dp<=12; dp++){
        if(await attempt('character.getCharacter', {characterId:id, displayPosition:dp})) break;
      }
    }

    // 4) leftovers
    if(!acc){
      step('getCharacter4Memory');
      await attempt('character.getCharacter4Memory', {characterId:id});
    }

    // 5) always worth merging: carries avatar, tags, visibility, user{id}
    step('queryRecentCharacters');
    try{
      const j = await trpc('character.queryRecentCharacters', {nsfw:true, locale:'en'});
      const list = j?.characters || j?.items || (Array.isArray(j) ? j : []);
      const row = Array.isArray(list) ? list.find(x => x && String(x.id)===String(id)) : null;
      if(row){ acc = mergeChar(acc, row); hits.push('queryRecentCharacters'); }
    }catch(_){ }

    if(acc) acc.__procs = hits;
    return acc;
  }

  // --- last resort: whatever the page shows -----------------------------------
  function domFallback(){
    const meta = n => document.querySelector(`meta[property="${n}"], meta[name="${n}"]`)?.content || '';
    const name = cleanAiNameExact(meta('og:title') || document.title);
